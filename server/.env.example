# Configuração do servidor — MODELO. Copie para `.env` com `npm run setup` (gera os segredos).
# NUNCA versione o arquivo `.env` (já está no .gitignore).

NODE_ENV=development
# 127.0.0.1 = só esta máquina. Use 0.0.0.0 apenas se quiser testar de outro aparelho na rede.
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

DATABASE_PATH=./data/zehenia.db
FILES_DIR=./data/files

# Origens (front-end) que podem chamar a API e abrir o WebSocket. Sem curinga.
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000,http://127.0.0.1:3000

# Segredos: no mínimo 32 caracteres aleatórios, diferentes entre si. `npm run setup` gera.
# Trocar o TOKEN_SECRET encerra todas as sessões. Trocar o PASSWORD_PEPPER invalida TODAS as senhas.
TOKEN_SECRET=troque-este-valor-com-npm-run-setup
PASSWORD_PEPPER=troque-este-valor-com-npm-run-setup
PASSWORD_COST=17

COOKIE_SECURE=true
# IPs ou faixas CIDR dos proxies reversos na frente do servidor, separados por vírgula (vazio = acesso direto).
# Ex.: TRUSTED_PROXIES=127.0.0.1 com o nginx na mesma máquina. Nunca liste faixas de onde clientes conectam.
TRUSTED_PROXIES=
SESSION_TTL_HOURS=168
SESSION_IDLE_HOURS=24
MAX_UPLOAD_MB=10
USER_QUOTA_MB=500
TABLE_QUOTA_MB=2000

# Página de testes em http://localhost:3000/dev/ (proibido em produção)
DEV_TOOLS=true
RATE_LIMIT=true

# Senha das contas de exemplo criadas por `npm run seed` (gerada pelo setup)
SEED_PASSWORD=troque-este-valor-com-npm-run-setup
