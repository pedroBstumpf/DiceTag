# Bloqueia scripts de instalação (preinstall/postinstall) de pacotes: defesa contra pacotes
# maliciosos na cadeia de dependências. O servidor não usa pacotes nativos, então nada quebra.
ignore-scripts=true
# Versões exatas no package.json (o lockfile continua sendo a fonte da verdade).
save-exact=true
# Falha se a versão do Node não atender ao campo "engines".
engine-strict=true
audit-level=moderate
fund=false
