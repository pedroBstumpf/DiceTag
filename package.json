{
  "name": "cronicas-de-zehenia",
  "version": "0.6.0",
  "scripts": {
    "mesa": "npm --prefix server run mesa --",
    "ng": "ng",
    "start": "ng serve",
    "prebuild": "node scripts/check-deps.mjs",
    "build": "ng build",
    "check:deps": "node scripts/check-deps.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "eslint src",
    "lint:prune": "eslint src --prune-suppressions",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "test:ci": "ng test --watch=false --coverage",
    "audit": "npm audit --audit-level=high",
    "format": "prettier --write",
    "prepare": "husky"
  },
  "private": true,
  "packageManager": "npm@10.9.4",
  "dependencies": {
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.26",
    "@angular/compiler": "^21.2.26",
    "@angular/core": "^21.2.26",
    "@angular/forms": "^21.2.26",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.26",
    "@angular/router": "^21.2.26",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-text-align": "^3.31.4",
    "@tiptap/extensions": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.26",
    "@angular/cli": "^21.2.26",
    "@angular/compiler-cli": "^21.2.26",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@vitest/coverage-v8": "^4.1.12",
    "angular-eslint": "^21.4.0",
    "eslint": "^10.15.0",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "lint-staged": "^17.6.2",
    "postcss": "^8.5.29",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.74.0",
    "vitest": "^4.0.8"
  },
  "lint-staged": {
    "src/**/*.{ts,html}": "eslint --max-warnings=0"
  }
}
